# Generated by record-terminal-demo
Output docs/cn-textbook-demo.gif

Require uv

Env PATH "C:\\Users\\anyda\\scoop\\shims;C:\\ProgramData\\chocolatey\\lib\\ffmpeg-full\\tools\\ffmpeg\\bin;C:\\Users\\anyda\\.local\\bin;C:\\Users\\anyda\\go\\bin;C:\\Program Files\\Git\\usr\\bin;C:\\Program Files\\Git\\bin;C:\\Windows\\System32;C:\\Windows"
Set Shell "bash"
Set FontFamily "Cascadia Mono, Microsoft YaHei"
Set FontSize 16
Set Width 1700
Set Height 680
Set Padding 24
Set CursorBlink true
Set TypingSpeed 8ms

Hide
Sleep 2s
Type "rm -rf ct-demo"
Enter
Type "export PYTHONUTF8=1"
Enter
Type "bind 'set enable-bracketed-paste off'"
Enter
Type "PS1='$ '"
Enter
Type "clear"
Enter
Sleep 1s
Show

# 1. 命令总览
Type "uv run cn-textbook --help < /dev/null"
Enter
Sleep 3s

# 2. download 选项
Type "uv run cn-textbook download --help < /dev/null"
Enter
Sleep 4s

# 3. dry-run：只列出匹配文件
Type "uv run cn-textbook download --dry-run --include README.md < /dev/null"
Enter
Sleep 14s

# 4. TUI 下载一个文件（进度条 + 完成状态）
Type "uv run cn-textbook download --dest ct-demo --include README.md"
Enter
Sleep 15s

Hide
Type "rm -rf ct-demo"
Enter
Sleep 1s
Show
